<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.module.graphql-core"
       name="graphql-core"
       version="3.3.1"
       provider-name="Christoph Zwerschke">

    <requires>
        <import addon="xbmc.python" version="3.0.1" />
    </requires>

    <extension point="xbmc.python.module" library="lib" />

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">GraphQL implementation for Python</summary>
        <description lang="en_GB">GraphQL-core is a Python port of GraphQL.js, the JavaScript reference implementation for GraphQL, a query language for APIs created by Facebook</description>
        <license>MIT</license>
        <platform>all</platform>
        <source>https://github.com/graphql-python/graphql-core</source>
    </extension>

</addon>
